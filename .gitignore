# Dependencies
node_modules/
dist/

# Rust build artifacts (this is the huge folder)
src-tauri/target/

# Local Cargo linker/toolchain overrides
src-tauri/.cargo/

# Logs and environment
*.log
.env

# Local agent handoff notes
AGENTS.md
ROADMAP.md
checkpoint.md

# OS generated files
.DS_Store
Thumbs.db

# IDE directories
.vscode/
.idea/

# Build artifacts
*.exe
*.msi
*.AppImage

# Auto-generated Tauri schemas (regenerated on each build)
src-tauri/gen/schemas/

# Platform-specific icons not needed for Windows-only build
src-tauri/icons/ios/
src-tauri/icons/android/
src-tauri/icons/icon.icns
