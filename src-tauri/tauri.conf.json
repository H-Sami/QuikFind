{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.quikfind.app",
  "productName": "QuikFind",
  "version": "1.0.1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "copyright": "© 2026 QuikFind",
    "category": "Utility",
    "shortDescription": "Lightning-fast local search"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuikFind",
        "width": 720,
        "height": 480,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "globalShortcut": {
      "all": true
    }
  }
}
